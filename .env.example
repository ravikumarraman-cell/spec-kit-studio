# GEMINI_API_KEY: Required only when Gemini generation is enabled.
# In Vercel, add this as an encrypted environment variable for the environments
# where Gemini should be available. Never expose it as a VITE_* variable.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PRODUCTION RUNTIME: Set these only in the deployment platform's protected
# configuration, never in a committed file. The container supplies safe host
# and port defaults; list them here to make the deployment contract explicit.
# NODE_ENV="production"
# HOST="0.0.0.0"
# PORT="3000"
# REQUEST_BODY_LIMIT="10mb"
# SHUTDOWN_GRACE_PERIOD_MS="10000"

# APP_URL: Optional public Studio URL, for integrations that need a callback URL.
# Example: https://spec-kit-studio.example.com
APP_URL="MY_APP_URL"

# GITHUB_TOKEN: Optional GitHub Personal Access Token for LOCAL/PERSONAL USE
# ONLY. Studio accepts this mode only for repositories GitHub confirms are
# public. Never use it for a company/private repository.
GITHUB_TOKEN=""

# ENTERPRISE SSO + PRIVATE GITHUB: Opt-in and fail-closed. Use company OIDC
# for Studio identity and a GitHub App installation for company repositories.
# Do not expose any of these values with a VITE_ prefix or commit real values.
# STUDIO_AUTH_MODE="enterprise"
# STUDIO_SESSION_SECRET="at-least-32-random-characters-from-a-secret-manager"
# STUDIO_SESSION_TTL_MS="28800000"
# STUDIO_OIDC_ISSUER="https://login.microsoftonline.com/<tenant-id>/v2.0"
# STUDIO_OIDC_CLIENT_ID="<confidential-client-id>"
# STUDIO_OIDC_CLIENT_SECRET="<secret-manager-reference>"
# Entra SPA/public-client registrations use PKCE and have no client secret.
# Set this to `none` only for a public-client registration.
# STUDIO_OIDC_CLIENT_AUTH_METHOD="none"
# STUDIO_OIDC_REDIRECT_URI="https://studio.example.com/api/auth/callback"
# STUDIO_OIDC_SCOPES="openid,profile,email"
# STUDIO_OIDC_REQUIRED_GROUP_IDS="<studio-access-group-object-id>"
# Production normally fails closed when server credentials are present and
# Studio authentication is disabled. Do not set this override unless this is
# intentionally a public deployment and its owner has accepted that risk.
# STUDIO_ALLOW_PUBLIC_SERVER_CREDENTIALS="false"
# STUDIO_GITHUB_APP_ID="<github-app-id>"
# STUDIO_GITHUB_APP_INSTALLATION_ID="<github-app-installation-id>"
# STUDIO_GITHUB_APP_PRIVATE_KEY="<secret-manager-reference>"
# STUDIO_GITHUB_API_URL="https://api.github.com" # set GHES API host if used
# Per-user GitHub OAuth: PMs/BAs click Connect GitHub and use normal browser SSO.
# STUDIO_GITHUB_OAUTH_CLIENT_ID="<github-oauth-client-id>"
# STUDIO_GITHUB_OAUTH_CLIENT_SECRET="<secret-manager-reference>"
# STUDIO_GITHUB_OAUTH_REDIRECT_URI="http://localhost:3000/api/auth/github/callback"
# Optional: start connection at this organization's corporate SSO page first.
# STUDIO_GITHUB_SSO_ORGANIZATION="optum-eeps"

# JIRA CONFIGURATION: Optional Jira Cloud credentials.
# Used to query Jira projects/boards and sync user stories/tasks directly to Jira tickets.
JIRA_DOMAIN="company.atlassian.net"
JIRA_EMAIL="developer@company.com"
JIRA_API_TOKEN=""

# LOCAL CONNECTOR: optional but recommended when using Connected Workspace.
# The connector can access only repositories inside these comma-separated directories.
# Do not use a broad home-directory path unless that is intentional.
STUDIO_ALLOWED_ROOTS="/absolute/path/to/your/repos"
# Protects the loopback connector from other local browser processes.
STUDIO_CONNECTOR_TOKEN="replace-with-a-long-random-value"
# Optional model override for the built-in Codex adapter only. Other adapters
# use the command and arguments configured for that local CLI.
STUDIO_CODEX_MODEL="gpt-5.6-luna"
# Optional only when Codex authentication is intentionally stored outside the
# default ~/.codex location. Studio strips inherited IDE/Codex session state.
# STUDIO_CODEX_HOME="/absolute/path/to/.codex"
# Optional JSON adapter registry for additional locally installed CLIs. Studio
# never accepts commands from the browser: command and arguments are owned by
# this local configuration. Each operation contains exactly one $PROMPT token.
# STUDIO_AGENT_ADAPTERS_JSON='[{"id":"aider","label":"Aider","command":"aider","versionArgs":["--version"],"operations":{"planning":["--message","$PROMPT"],"implementation":["--message","$PROMPT"],"story-extraction":["--message","$PROMPT"]}}]'
# Add your deployed Studio origin here when connecting a hosted web app.
STUDIO_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
