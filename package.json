{
  "name": "spec-kit-studio",
  "private": true,
  "version": "0.1.20",
  "description": "A local-first workspace for reviewable specification-driven development with GitHub Spec-Kit and coding agents.",
  "license": "Apache-2.0",
  "author": "Tenant Compass Team",
  "homepage": "https://rraviku2-uhg.github.io/spec-kit-studio/",
  "repository": {
    "type": "git",
    "url": "https://github.com/rraviku2_uhg/spec-kit-studio.git"
  },
  "bugs": {
    "url": "https://github.com/rraviku2_uhg/spec-kit-studio/issues"
  },
  "keywords": [
    "specification-driven-development",
    "github-spec-kit",
    "coding-agents",
    "ai-assisted-development",
    "software-delivery"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "connector": "node connector/server.mjs",
    "package:connector": "node scripts/package-local-connector.mjs",
    "check:container": "node scripts/check-container-contract.mjs",
    "check:public-deps": "node scripts/check-public-package-sources.mjs",
    "build": "npm run check:public-deps && npm run check:container && npm run package:connector && vite build && npm run check:bundle && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild server/vercel.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/vercel.cjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=low",
    "start": "node dist/server.cjs",
    "clean": "node -e \"const fs=require('node:fs'); for (const target of ['dist','server.js']) fs.rmSync(target,{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:responsive": "playwright test",
    "verify": "npm run lint && npm test && npm run build && npm run test:responsive",
    "smoke:production": "node scripts/smoke-production-server.mjs",
    "verify:production": "node scripts/check-production-runtime.mjs && npm run audit:production && npm run verify && npm run smoke:production"
  },
  "dependencies": {
    "@azure/msal-browser": "^2.39.0",
    "@google/genai": "^2.23.0",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-table": "8.20.6",
    "compression": "^1.8.2",
    "cross-spawn": "^7.0.6",
    "dotenv": "^17.2.3",
    "es-toolkit": "1.45.1",
    "express": "^4.22.3",
    "helmet": "^8.3.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "mermaid": "^11.17.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-error-boundary": "^6.1.5"
  },
  "overrides": {
    "lodash-es": "4.18.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^6.4.1"
  }
}
