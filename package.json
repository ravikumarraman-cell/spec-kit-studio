{
  "name": "spec-kit-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "connector": "node connector/server.mjs",
    "check:public-deps": "node scripts/check-public-package-sources.mjs",
    "build": "npm run check:public-deps && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild server/vercel.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/vercel.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "verify": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@google/genai": "^2.23.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-table": "8.20.6",
    "@vitejs/plugin-react": "^6.1.1",
    "compression": "^1.8.2",
    "dotenv": "^17.2.3",
    "express": "^4.22.3",
    "helmet": "^8.3.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "mermaid": "^11.17.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-error-boundary": "^6.1.5",
    "vite": "^8.3.0"
  },
  "overrides": {
    "lodash-es": "4.17.23"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
