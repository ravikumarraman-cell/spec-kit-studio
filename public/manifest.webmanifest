{
  "name": "Spec-Kit Studio",
  "short_name": "Spec-Kit Studio",
  "description": "A local-first workspace for reviewable specification-driven development with GitHub Spec-Kit and coding agents.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#ffffff",
  "theme_color": "#083b2e",
  "icons": [
    {"src": "pwa-icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "pwa-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "pwa-maskable-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"},
    {"src": "pwa-icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any"},
    {"src": "pwa-maskable-icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "maskable"}
  ]
}
